# 前端环境变量示例
# 复制为 frontend/.env.development 或 frontend/.env.production 后按环境修改。

# 后端服务地址，不带 /api；前端 api.js 会自动拼接 /api
VITE_APP_BACKEND_API_URL=http://localhost:3000

# WPS WebOffice 配置
# WPS 应用 appid（在 WPS 开放平台创建应用后获取）
VITE_APP_WPS_APPID=your-wps-appid
# WPS 文件服务地址（后端提供文件下载的地址，通常同后端地址）
VITE_APP_WPS_FILE_BASE_URL=http://localhost:3000
